{
    "name": "Viper Black",
    "colors": {

		// --- Contrast Colors ---
		"contrastActiveBorder": "#00000000",
		"contrastBorder": "#00000000",

        // --- Base Colors ---
        "focusBorder": "#00FF00",
        "foreground": "#FFFFFF",
        "widget.shadow": "#00FF0050",
        "selection.background": "#00FF0050",
        "descriptionForeground": "#A0A0A0",
        "errorForeground": "#FF4444",
        "icon.foreground": "#FFFFFF",     
        
		// --- Window Border ---
        "window.activeBorder": "#00000000",
        "window.inactiveBorder": "#00000000",

        // --- Action Colors ---
        "toolbar.hoverBackground": "#00ff00bb",
        "toolbar.activeBackground": "#00ff0052",

        // --- Dropdown Control ---
        "dropdown.background": "#1d1d1d",
        "dropdown.border": "#00ff00",
        "dropdown.foreground": "#ffffff",

        // --- Input Control ---
        "input.background": "#000000",
        "input.border": "#00ff00",
        "input.placeholderForeground": "#A0A0A0",
        "inputOption.activeBackground": "#00ff00a1",
        "inputOption.activeForeground": "#000000",
        "inputOption.hoverBackground": "#00ff0075",

        // --- Scrollbar Control ---
        "scrollbarSlider.background": "#29292946",
        "scrollbarSlider.activeBackground": "#00ff0046",
        "scrollbarSlider.hoverBackground": "#00ff0031",

        // --- Lists and Trees ---
        "list.activeSelectionBackground":"#00ff0046",
        "list.activeSelectionForeground":"#FFFFFF",
        
        // --- Side Bar ---
        "sideBar.background": "#000000",
        "sideBar.foreground": "#FFFFFF",
        "sideBar.border": "#0e0e0e",
        "sideBarTitle.foreground": "#ffffff",
        "sideBarSectionHeader.background": "#1d1d1d",
        "sideBarSectionHeader.foreground": "#ffffff",
        "sideBarSectionHeader.border": "#0e0e0e",
        "sideBarActivityBarTop.border": "#0e0e0e",
        "sideBarTitle.background": "#000000",
        "sideBarTitle.border": "#0e0e0e",
        "sideBarStickyScroll.background": "#1d1d1d",
        "sideBarStickyScroll.border": "#0e0e0e",
        "sideBarStickyScroll.shadow": "#00ff00",

        // --- Editor Groups & Tabs ---
        "editorGroup.border": "#0e0e0e",
        "editorGroup.dropBackground": "#00ff0020",
        "editorGroupHeader.noTabsBackground": "#000000",
        "editorGroupHeader.tabsBackground": "#000000",
        "editorGroupHeader.tabsBorder": "#0e0e0e",
        "editorGroupHeader.border": "#0e0e0e",
        "tab.activeBackground": "#000000b6",
        "tab.activeForeground": "#ffffff",
        "tab.border": "#0e0e0e",
        "tab.selectedBorderTop": "#0e0e0e",
        "tab.selectedBackground": "#000000",
        "tab.selectedForeground": "#FFFFFF",
        "tab.dragAndDropBorder": "#00FF00",
        "tab.unfocusedActiveBorder": "#00000000",
        "tab.activeBorderTop": "#00FF00",
        "tab.inactiveBackground": "#00000067",
        "tab.inactiveForeground": "#ffffff",
        "editorPane.background": "#000000",
        "sideBySideEditor.horizontalBorder": "#0e0e0e",
        "sideBySideEditor.verticalBorder": "#0e0e0e",
		
		// --- Editor Colors ---
        "editor.background": "#000000",
        "editor.foreground": "#FFFFFF",
        "editorLineNumber.foreground": "#00ff0046",
        "editorLineNumber.activeForeground": "#00FF00",
        "editorCursor.foreground": "#aaaaaa",
        "editor.selectionBackground": "#00ff003d",
        "editor.inactiveSelectionBackground": "#31313150",
        "editor.selectionHighlightBackground": "#00FF0020",
        "editor.wordHighlightBackground": "#00ff007c",
        "editor.wordHighlightStrongBackground": "#00ff0031",
        "editor.hoverHighlightBackground": "#00ff0041",
        "editorLink.activeForeground": "#00FFFF",
        "editorWidget.background": "#1d1d1d",
        "editorSuggestWidget.background": "#111111",
        "editorSuggestWidget.border": "#00ff00",
        "editorSuggestWidget.highlightForeground": "#00FFFF",
        "editorError.foreground": "#FF4444",
        "editorWarning.foreground": "#FFFF00",
        "editorInfo.foreground": "#00FFFF",
        "editorHint.foreground": "#A0A0A0",
        "editorGutter.background": "#000000",
        "editorGutter.modifiedBackground": "#000000",
        "editorGutter.addedBackground": "#00FF00",
        "editorGutter.deletedBackground": "#FF4444",
        "editorOverviewRuler.border": "#313131",
        "editor.stackFrameHighlightBackground": "#00FFFF30",
        "editor.focusedStackFrameHighlightBackground": "#00FF0050",
        "editorBracketMatch.border": "#00FF00",

        // --- Panel Colors ---
        "panel.background": "#000000",
        "panel.border": "#0e0e0e",
        "panel.dropBorder": "#00FF00",
        "panelTitle.activeBorder": "#00FF00",
        "panelTitle.activeForeground": "#FFFFFF",
        "panelTitle.border": "#0e0e0e",
        "panelTitleBadge.background": "#00FF00",
        "panelTitleBadge.foreground": "#000000",
        "panelInput.border": "#0e0e0e",
        "panelSection.border": "#0e0e0e",
        "panelSection.dropBackground": "#00FF0020",
        "panelSectionHeader.background": "#000000",
        "panelSectionHeader.foreground": "#ffffff",
        "panelStickyScroll.background": "#000000",
        "panelStickyScroll.border": "#0e0e0e",
        "panelStickyScroll.shadow": "#00ff00",

        // --- Title Bar Colors ---
        "titleBar.activeBackground": "#000000",
        "titleBar.activeForeground": "#FFFFFF",
        "titleBar.inactiveBackground": "#000000",
        "titleBar.inactiveForeground": "#FFFFFF",
        "titleBar.border": "#0e0e0e",

        // --- Banner Colors ---
        "banner.background": "#1d1d1d",
        "banner.foreground": "#ffffff",
        "banner.iconForeground": "#ffffff",

        // --- Integrated Terminal Colors ---
        "terminal.background": "#000000",
        "terminal.border": "#0e0e0e",
        "terminal.foreground": "#FFFFFF",
        
    },
    
    "tokenColors": [
        // --- General Scopes (Comments, Variables, Keywords, etc.) ---
        {
            "name": "Comments",
            "scope": [
                "comment",
                "punctuation.definition.comment"
            ],
            "settings": {
                "fontStyle": "italic",
                "foreground": "#008800"
            }
        },
        {
            "name": "Keywords (if, function, class, etc.)",
            "scope": [
                "keyword",
                "storage.type",
                "storage.modifier",
                "keyword.control"
            ],
            "settings": {
                "foreground": "#D67BFF"
            }
        },
        {
            "name": "Variables / Parameters",
            "scope": [
                "variable",
                "variable.parameter",
                "string constant.other.placeholder",
                "meta.block variable.other",
                "support.other.variable"
            ],
            "settings": {
                "foreground": "#00FFFF"
            }
        },
        {
            "name": "Functions / Methods / Calls",
            "scope": [
                "entity.name.function",
                "meta.function-call",
                "variable.function",
                "support.function",
                "keyword.other.special-method",
                "entity.name.method.js",
                "variable.function.constructor"
            ],
            "settings": {
                "foreground": "#63C6FF"
            }
        },
        {
            "name": "Class Names / Type Definitions",
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "support.type",
                "support.class",
                "entity.other.inherited-class"
            ],
            "settings": {
                "foreground": "#FFC866"
            }
        },
        {
            "name": "Strings / Template Literals",
            "scope": [
                "string",
                "constant.other.symbol",
                "constant.other.key",
                "markup.inserted.git_gutter",
                "meta.group.braces.curly constant.other.object.key.js string.unquoted.label.js"
            ],
            "settings": {
                "foreground": "#E0FF66"
            }
        },
        {
            "name": "Numbers / Constants (True, False, null)",
            "scope": [
                "constant.numeric",
                "constant.language",
                "support.constant",
                "constant.character",
                "keyword.other.unit"
            ],
            "settings": {
                "foreground": "#FFEC00"
            }
        },
        {
            "name": "Operators / Punctuation / Misc",
            "scope": [
                "keyword.operator", 
                "punctuation",
                "meta.tag",
                "punctuation.definition.tag",
                "punctuation.separator.inheritance.php",
                "punctuation.definition.tag.html",
                "punctuation.definition.tag.begin.html",
                "punctuation.definition.tag.end.html",
                "punctuation.section.embedded",
                "keyword.other.template",
                "keyword.other.substitution",
                "constant.character.escape",
                "string.regexp" 
            ],
            "settings": {
                "foreground": "#BBBBBB"
            }
        },
        {
            "name": "HTML/XML Tag Names",
            "scope": [
                "entity.name.tag",
                "meta.tag.sgml",
                "markup.deleted.git_gutter"
            ],
            "settings": {
                "foreground": "#FF6699"
            }
        },
        {
            "name": "HTML/CSS Attributes and Selectors",
            "scope": [
                "entity.other.attribute-name",
                "source.css support.type.property-name",
                "source.sass support.type.property-name",
                "source.scss support.type.property-name",
                "entity.other.attribute-name.class",
                "source.sass keyword.control"
            ],
            "settings": {
                "fontStyle": "italic",
                "foreground": "#F7A855"
            }
        },
        {
            "name": "Import/Module Names (JS/TS)",
            "scope": [
                "entity.name.module.js",
                "variable.import.parameter.js",
                "variable.other.class.js"
            ],
            "settings": {
                "foreground": "#FF6699"
            }
        },
        
        // --- Markdown ---
        {
            "name": "Markdown Heading",
            "scope": [
                "markdown.heading",
                "markup.heading | markup.heading entity.name",
                "markup.heading.markdown punctuation.definition.heading.markdown"
            ],
            "settings": {
                "foreground": "#98FF7F"
            }
        },
        {
            "name": "Markdown Links/URLs",
            "scope": [
                "string.other.link.title.markdown",
                "constant.other.reference.link.markdown"
            ],
            "settings": {
                "foreground": "#63C6FF",
                "fontStyle": "underline"
            }
        },
        {
            "name": "Markdown Link Descriptions/Brackets",
            "scope": [
                "string.other.link.description.title.markdown"
            ],
            "settings": {
                "foreground": "#D67BFF"
            }
        },
        {
            "name": "Markdown Bold/Italic",
            "scope": [
                "markup.italic",
                "markup.bold",
                "markup.bold string",
                "markup.bold markup.italic",
                "markup.italic markup.bold",
                "markup.quote markup.bold"
            ],
            "settings": {
                "fontStyle": "bold italic",
                "foreground": "#FF6699"
            }
        },
        {
            "name": "Markup Raw/Code Blocks",
            "scope": [
                "markup.raw.block",
                "text.html.markdown markup.inline.raw.markdown"
            ],
            "settings": {
                "foreground": "#FFC866"
            }
        },

        // --- JSON Specific Keys ---
        {
            "name": "JSON Key - Level 0",
            "scope": [
                "source.json meta.structure.dictionary.json support.type.property-name.json"
            ],
            "settings": {
                "foreground": "#D67BFF"
            }
        },
        {
            "name": "JSON Key - Level 1",
            "scope": [
                "source.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json support.type.property-name.json"
            ],
            "settings": {
                "foreground": "#FFC866"
            }
        },
        {
            "name": "JSON Key - Level 2",
            "scope": [
                "source.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json support.type.property-name.json"
            ],
            "settings": {
                "foreground": "#F7A855"
            }
        },
        {
            "name": "JSON Key - Level 3+",
            "scope": [
                "source.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json support.type.property-name.json",
                "source.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json support.type.property-name.json",
                "source.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json support.type.property-name.json",
                "source.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json support.type.property-name.json",
                "source.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json support.type.property-name.json",
                "source.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json support.type.property-name.json"
            ],
            "settings": {
                "foreground": "#FF6699"
            }
        },
        
        // --- Error/Warning Colors ---
        {
            "name": "Invalid",
            "scope": [
                "invalid",
                "invalid.illegal"
            ],
            "settings": {
                "foreground": "#FF4444"
            }
        }
    ]
}